{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug train_quant",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/train_quant",
            "args": [
              "--seed", "101",
              "--model-variant", "w16_dx8_conv12conv24fc4",
              "--epochs", "1",
              "--batch-size", "256",
              "--s-eta", "13",
              "--log-interval", "1"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build train_quant",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
